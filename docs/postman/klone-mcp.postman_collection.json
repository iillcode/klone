{
  "info": {
    "name": "klone-mcp",
    "description": "PDF-document MCP server (Cloudflare Worker).\n\nFlow:\n1. Run \"1. Auth - Get Token\" once (or let the collection auto-refresh it).\n2. Call any tool. Every request auto-attaches the Bearer token via collection pre-request script.\n3. Templates: list_pdf_templates -> get_pdf_template returns the blueprint outline to author a document from.\n4. create_document saves the composed HTML under the user's account and captures the id into {{document_id}} for get/update/delete.\n\nServer: local wrangler dev on port 8789.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "mcp_url",
      "value": "http://127.0.0.1:8789/mcp"
    },
    {
      "key": "supabase_url",
      "value": "https://jdzhnwmfbfdocqncwfay.supabase.co"
    },
    {
      "key": "anon_key",
      "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Impkemhud21mYmZkb2NxbmN3ZmF5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYwMDg2NjYsImV4cCI6MjEwMTU4NDY2Nn0.eopsD2QWQiJ7yByczGYf7rZokpl12W4kMw85u-WrkRc"
    },
    {
      "key": "email",
      "value": "mcp-test@klone.dev"
    },
    {
      "key": "password",
      "value": "McpTest123!"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "token_expires_at",
      "value": "0"
    },
    {
      "key": "document_id",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Auto-refresh the Supabase access token when missing or about to expire.",
          "// Skips the auth request itself.",
          "if (pm.request.url.toString().indexOf('grant_type=password') !== -1) {",
          "  return;",
          "}",
          "",
          "const token = pm.collectionVariables.get('access_token');",
          "const expiresAt = Number(pm.collectionVariables.get('token_expires_at') || 0);",
          "const now = Date.now();",
          "",
          "if (!token || now >= expiresAt - 60000) {",
          "  const url = pm.collectionVariables.get('supabase_url') + '/auth/v1/token?grant_type=password';",
          "  const body = {",
          "    email: pm.collectionVariables.get('email'),",
          "    password: pm.collectionVariables.get('password')",
          "  };",
          "  pm.sendRequest({",
          "    url: url,",
          "    method: 'POST',",
          "    header: {",
          "      'apikey': pm.collectionVariables.get('anon_key'),",
          "      'Content-Type': 'application/json'",
          "    },",
          "    body: { mode: 'raw', raw: JSON.stringify(body) }",
          "  }, function (err, res) {",
          "    if (err) { console.log('Token refresh failed: ' + err); return; }",
          "    const data = res.json();",
          "    if (data.access_token) {",
          "      pm.collectionVariables.set('access_token', data.access_token);",
          "      pm.collectionVariables.set('token_expires_at', String(now + data.expires_in * 1000));",
          "      console.log('Token refreshed');",
          "    } else {",
          "      console.log('Token refresh failed: ' + JSON.stringify(data));",
          "    }",
          "  });",
          "}"
        ],
        "type": "text/javascript"
      }
    },
    {
      "listen": "test",
      "script": {
        "exec": [
          "// Log any JSON-RPC errors; validate the response shape.",
          "try {",
          "  const body = pm.response.json();",
          "  if (body && body.error) {",
          "    console.log('JSON-RPC error: ' + JSON.stringify(body.error));",
          "    pm.test('No JSON-RPC error', function () { pm.expect(body.error).to.be.undefined; });",
          "  }",
          "} catch (e) {}"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Auth - Get Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.access_token) {",
                  "  pm.collectionVariables.set('access_token', data.access_token);",
                  "  pm.collectionVariables.set('token_expires_at', String(Date.now() + data.expires_in * 1000));",
                  "  pm.test('Got access token', function () { pm.expect(data.access_token).to.not.be.empty; });",
                  "} else {",
                  "  pm.test('Auth failed', function () { pm.expect.fail('No access_token in response: ' + JSON.stringify(data)); });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{supabase_url}}/auth/v1/token?grant_type=password",
              "host": ["{{supabase_url}}"],
              "path": ["auth", "v1", "token"],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                }
              ]
            },
            "description": "Fetches a Supabase access token for the test user and stores it in the {{access_token}} variable. Also stores expiry in {{token_expires_at}}."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Protocol",
      "item": [
        {
          "name": "2. initialize",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"initialize\",\n  \"params\": {\n    \"protocolVersion\": \"2025-06-18\",\n    \"capabilities\": {},\n    \"clientInfo\": { \"name\": \"postman\", \"version\": \"1.0\" }\n  }\n}"
            },
            "url": {
              "raw": "{{mcp_url}}",
              "host": ["{{mcp_url}}"]
            },
            "description": "Handshake. Returns serverInfo (klone-mcp 1.0.0) and protocol version."
          },
          "response": []
        },
        {
          "name": "3. tools/list",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 2,\n  \"method\": \"tools/list\"\n}"
            },
            "url": {
              "raw": "{{mcp_url}}",
              "host": ["{{mcp_url}}"]
            },
            "description": "Lists all 7 registered tools with their schemas."
          },
          "response": []
        }
      ]
    },
    {
      "name": "PDF Templates",
      "item": [
        {
          "name": "4. list_pdf_templates",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 3,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"list_pdf_templates\",\n    \"arguments\": {}\n  }\n}"
            },
            "url": {
              "raw": "{{mcp_url}}",
              "host": ["{{mcp_url}}"]
            },
            "description": "Lists active PDF templates (metadata only). Try the \"category\" filter (e.g. Reports, Business, Technical) or a \"query\" search."
          },
          "response": []
        },
        {
          "name": "5. get_pdf_template",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 4,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"get_pdf_template\",\n    \"arguments\": {\n      \"slug\": \"business-report\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{mcp_url}}",
              "host": ["{{mcp_url}}"]
            },
            "description": "MAIN ENTRY POINT. Returns the full blueprint outline (page constraints, sections with guidance, requirements). Change slug to: blank, business-report, invoice, api-docs, letter. Or pass template_id instead."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Documents (CRUD)",
      "item": [
        {
          "name": "6. create_document",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Capture the created document id into {{document_id}} for get/update/delete.",
                  "try {",
                  "  const r = pm.response.json();",
                  "  const text = r.result.content[0].text;",
                  "  const parsed = JSON.parse(text);",
                  "  if (parsed.data && parsed.data.document && parsed.data.document.id) {",
                  "    pm.collectionVariables.set('document_id', parsed.data.document.id);",
                  "    console.log('Saved document_id: ' + parsed.data.document.id);",
                  "  }",
                  "} catch (e) { console.log('Could not parse id: ' + e); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 5,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"create_document\",\n    \"arguments\": {\n      \"title\": \"Q3 Business Report\",\n      \"description\": \"Draft authored from the business-report blueprint\",\n      \"html_code\": \"<!DOCTYPE html><html><head><style>body{font-family:ui-sans-serif,system-ui,sans-serif;max-width:794px;margin:0 auto;padding:2.5rem;color:#111827}h1{font-size:32px}h2{font-size:22px;margin-top:2rem}table{border-collapse:collapse;width:100%}th,td{border:1px solid #e5e7eb;padding:8px;text-align:left}th{background:#f9fafb}</style></head><body><h1>Q3 Business Report</h1><h2>Executive summary</h2><p>Revenue grew 18% quarter over quarter driven by enterprise expansion.</p><h2>Key findings</h2><ul><li><strong>Revenue</strong> up 18%</li><li><strong>Churn</strong> down to 2.1%</li></ul><h2>Data table</h2><table><tr><th>Metric</th><th>Q2</th><th>Q3</th></tr><tr><td>MRR</td><td>$120k</td><td>$142k</td></tr><tr><td>Active users</td><td>8,400</td><td>9,900</td></tr></table><h2>Recommendations</h2><ol><li>Double down on enterprise sales motion.</li><li>Ship the self-serve onboarding flow.</li></ol></body></html>\",\n      \"template_slug\": \"business-report\",\n      \"prompt_used\": \"a Q3 business report with executive summary, findings, a data table and recommendations\",\n      \"metadata\": { \"source\": \"postman\" }\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{mcp_url}}",
              "host": ["{{mcp_url}}"]
            },
            "description": "Saves a composed HTML document under your account (user_id from the JWT), with template provenance. Captures the new id into {{document_id}}."
          },
          "response": []
        },
        {
          "name": "7. list_documents",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 6,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"list_documents\",\n    \"arguments\": {}\n  }\n}"
            },
            "url": {
              "raw": "{{mcp_url}}",
              "host": ["{{mcp_url}}"]
            },
            "description": "Lists your documents, most recently updated first."
          },
          "response": []
        },
        {
          "name": "8. get_document",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 7,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"get_document\",\n    \"arguments\": {\n      \"id\": \"{{document_id}}\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{mcp_url}}",
              "host": ["{{mcp_url}}"]
            },
            "description": "Fetch one document by id. Uses the {{document_id}} captured by the create request."
          },
          "response": []
        },
        {
          "name": "9. update_document",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 8,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"update_document\",\n    \"arguments\": {\n      \"id\": \"{{document_id}}\",\n      \"title\": \"Q3 Business Report v2\",\n      \"metadata\": { \"tone\": \"professional\" }\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{mcp_url}}",
              "host": ["{{mcp_url}}"]
            },
            "description": "Updates only the provided fields (title, description, html_code, css_code, template_id, template_slug, prompt_used, metadata)."
          },
          "response": []
        },
        {
          "name": "10. delete_document",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 9,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"delete_document\",\n    \"arguments\": {\n      \"id\": \"{{document_id}}\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{mcp_url}}",
              "host": ["{{mcp_url}}"]
            },
            "description": "Deletes the document owned by you."
          },
          "response": []
        }
      ]
    }
  ]
}
