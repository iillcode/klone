{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "klone-web",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Cloudflare Browser Run — used by app/api/pdf (quickAction "pdf").
  // No API token needed; the browser runs on Cloudflare's infra.
  "browser": {
    "binding": "BROWSER"
  }
}
